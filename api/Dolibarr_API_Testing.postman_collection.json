    {
      "name": "4. Stock & Products",
      "item": [
        {
          "name": "GET Products List",
          "request": {
            "method": "GET",
            "header": [
              { "key": "DOLAPIKEY", "value": "{{apiKey}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products?limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [{ "key": "limit", "value": "10" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Products list contains PR001', function () {",
                  "    var data = pm.response.json();",
                  "    var found = data.some(function(p) { return p.ref === 'PR001'; });",
                  "    pm.expect(found).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Product PR001 Stock Info",
          "request": {
            "method": "GET",
            "header": [
              { "key": "DOLAPIKEY", "value": "{{apiKey}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/1/stock",
              "host": ["{{baseUrl}}"],
              "path": ["products", "1", "stock"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Stock info has real stock number', function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.stock_reel).to.not.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
